# Maintainer: Alexandru-Ionuț Chiuță <alexio@trom.tf>
# Source build from the tagged release. Not submitted to the AUR yet; syntax-checked only.
# Layout follows the Arch wiki "Rust package guidelines" (prepare/fetch, --frozen, check without --release; read 2026-11-04).
# Needs rustc >= 1.95 (workspace rust-version).
pkgname=legatorocr
pkgver=0.2.0
pkgrel=1
pkgdesc='Scan post-processing (ScanTailor-like), PDF export and OCR'
arch=('x86_64' 'aarch64')
url='https://github.com/chiuta/LegatorOCR'
license=('MIT')
depends=('gcc-libs')
optdepends=('tesseract: OCR engine' 'tesseract-data-ron: Romanian OCR data' 'tesseract-data-eng: English OCR data' 'poppler: PDF renderer (pdftoppm)' 'mupdf-tools: PDF renderer (mutool)' 'ghostscript: PDF renderer' 'qpdf: page counts of damaged or encrypted PDFs' 'openssl: signatures and time stamps' 'curl: time-stamp requests')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with the real checksum when the tag is published

prepare() {
  cd "LegatorOCR-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "LegatorOCR-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p legatorocr-cli
}

check() {
  cd "LegatorOCR-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen -p legatorocr-core
}

package() {
  cd "LegatorOCR-$pkgver"
  install -Dm755 target/release/legatorocr "$pkgdir/usr/bin/legatorocr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.md"
}
